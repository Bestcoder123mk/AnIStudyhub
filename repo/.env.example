# Copy this file to .env.local (or .env) and fill in real values.
# .env* is gitignored — your real key never gets committed.

# Required for AI Tutor and the Sanskrit Translator.
# Get a key at https://console.anthropic.com
MY_LLM_API_KEY=

# Optional — override the default model (claude-haiku-4-5-20251001).
# Use claude-sonnet-5 for stronger reasoning on math solving / essay review.
# MY_LLM_MODEL=claude-sonnet-5

# Leftover from the original scaffold — nothing in the app actually reads
# from this database (progress is saved to localStorage). Safe to ignore.
DATABASE_URL=file:./db/custom.db
