# Copy this file to .env.local (or .env) and fill in real values.
# .env* is gitignored — your real key never gets committed.

# Required for AI Tutor and the Sanskrit Translator.
# src/lib/llm.ts calls Google's Gemini API — get a key at
# https://aistudio.google.com/apikey (an Anthropic/Claude key will NOT work here).
MY_LLM_API_KEY=

# Optional — override the default model (gemini-3.6-flash).
# Use gemini-2.5-pro for stronger reasoning on math solving / essay review.
# MY_LLM_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Protecting your API key (all optional, but worth setting for a public deploy)
# ---------------------------------------------------------------------------
# The AI routes are rate limited per IP (8 messages/minute, 120/day). By default
# the counters live in server memory, which on Vercel resets on every cold start
# and isn't shared between instances — fine for a handful of users, not a shield.
#
# For limits that actually hold, add a free Upstash Redis (Vercel dashboard ->
# Storage -> Upstash Redis / KV) and set EITHER pair — Vercel's integration adds
# the KV_* names for you:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# A hard cap on TOTAL AI requests per day across all visitors (0 / unset = off).
# This is the real protection for your bill, however many IPs someone rotates through.
# AI_GLOBAL_DAILY_LIMIT=2000
#
# Per-IP overrides (defaults shown):
# AI_BURST_LIMIT=8
# AI_DAILY_LIMIT=120
#
# Also set a spending cap / budget alert on the key itself in Google AI Studio / Cloud.
